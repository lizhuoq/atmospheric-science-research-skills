{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/method-rule.schema.json",
  "title": "Atmospheric Research Method Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "statement", "category", "applies_when", "does_not_apply_when", "strength", "sources", "review_status"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^rule-[a-z0-9-]+$"},
    "statement": {"type": "string", "minLength": 20},
    "category": {"type": "string"},
    "applies_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "does_not_apply_when": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "strength": {"enum": ["normative", "strong_consensus", "conditional", "candidate"]},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "year", "locator", "source_type"],
        "properties": {
          "doi": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "title": {"type": "string"},
          "year": {"type": "integer"},
          "locator": {"type": "string"},
          "source_type": {"enum": ["peer_reviewed", "authoritative_standard", "official_guidance"]}
        }
      }
    },
    "conflict_status": {"enum": ["not_checked", "none_found", "mixed", "contested"]},
    "review_status": {"enum": ["machine_draft", "human_checked", "expert_checked"]}
  }
}

